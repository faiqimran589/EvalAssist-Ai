# ==============================================================================
# EvalAssist AI — backend environment template
# Copy this file to `.env` and fill in your OWN values. NEVER commit real keys.
#   cp .env.example .env
# ==============================================================================

# --- Database ---
# SQLite (default) or any SQLAlchemy-compatible database URL.
DATABASE_URL=sqlite:///./evalassist.db

# --- Authentication / JWT ---
# REQUIRED. Use a long random value unique to your deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Google Gemini (Vision / OCR) ---
# REQUIRED for AI question/rubric extraction. Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional rotating keys to increase free-tier quota (leave blank to disable).
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.6-flash

# --- Groq Cloud (grading) ---
# Optional. Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Uploads / runtime tuning ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CONFIDENCE_THRESHOLD=0.75
