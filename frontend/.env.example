# ==============================================================================
# EvalAssist AI — frontend environment template
# Copy this file to `.env.local` and adjust if needed. NEVER commit real values.
#   cp .env.example .env.local
# ==============================================================================

# Base URL of the backend API.
# NOTE: When the app runs in the browser on localhost/127.0.0.1 it automatically
# targets http://localhost:8001/api/v1, and on other origins it uses same-origin
# /api/v1 (proxied by next.config.js). This value is only used for server-side
# rendering, so the default below is fine for local development.
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
